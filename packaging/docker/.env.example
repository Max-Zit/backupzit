# Copy to .env next to docker-compose.yml and fill in.

# Database password: letters and digits only, e.g. from: openssl rand -hex 24
DB_PASSWORD=

# The address agents use to reach the console (shown when enrolling agents).
PUBLIC_URL=https://backup.example.com:8443

# Names and IP addresses for the console's certificate, comma-separated.
TLS_HOSTS=backup.example.com,192.168.1.20

# Time zone for schedules, e.g. Europe/Belgrade.
TZ=UTC

# Image tag: latest (official releases), testing (release candidates) or a version such as 0.46.0.
BACKUPZIT_TAG=latest
