<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the BackupZit menu bar app when a user logs in (as the Run key
     does for the Windows tray). Only in graphical sessions (Aqua): an SSH
     login has no menu bar. Not kept alive: a user who quits the app keeps
     it closed until the next login. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.backupzit.tray</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/BackupZit.app/Contents/MacOS/backupzit-tray</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.backupzit.tray</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
