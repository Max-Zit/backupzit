#!/bin/sh
# Runs as root after the payload is in place: $1 is the path of the package
# being installed, $3 the target volume. Its output goes to
# /var/log/install.log.
#
# 1. Enrolls the agent when an enrollment code (BZ1-..., Agents > Create
#    enrollment token in the console) is provided. A package takes no
#    properties on the command line as the MSI does (ENROLLCODE=...), so the
#    code comes from a file, the first one found of:
#      /Library/Application Support/BackupZit/enroll-code
#          written by an MDM script before the installation (owned by root),
#          deleted once used: it holds an enrollment token
#      backupzit-enroll.txt next to the .pkg
#          for an installation by hand or from a shared folder; used only
#          while the Mac is not enrolled, and only when no other user could
#          have put it there (see side_code)
#    Upgrades and reinstalls with the same code keep the enrollment
#    (--if-not-enrolled); a console that cannot be reached now gets the code
#    retried by the service (--pending-ok), as with the MSI. Moving an
#    enrolled Mac to another console takes the root-owned MDM file.
# 2. Installs and (re)starts the agent's LaunchDaemon; the agent's "service"
#    command defines it.
# 3. Opens the menu bar app in the session of the logged-in user, whose
#    assistant guides him through the permissions only he can grant.
set -u

[ "${3:-/}" = "/" ] || { echo "BackupZit: not installed on the startup disk, nothing started"; exit 0; }

AGENT=/Library/BackupZit/bin/backupzit-agent
APP=/Applications/BackupZit.app
TRAY_PLIST=/Library/LaunchAgents/com.backupzit.tray.plist
TRAY_LABEL=com.backupzit.tray
# The agent's own folders on macOS (agent.DefaultConfigPath, agent.LogPath).
CFG_DIR="/Library/Application Support/BackupZit"
LOG_FILE=/Library/Logs/BackupZit/agent.log
MDM_CODE="$CFG_DIR/enroll-code"
AGENT_CFG=$CFG_DIR/agent.json

# Messages go to stderr: what read_code prints is the code itself.
log() { echo "BackupZit postinstall: $*" >&2; }

# read_code prints the enrollment code found in file $1, without the white
# space a copy and paste adds (as the agent itself does), or nothing.
read_code() {
    [ -f "$1" ] || return 0
    code=$(head -c 8192 "$1" | tr -d ' \t\r\n')
    case $code in
        BZ1-*) ;;
        *) log "ignoring $1: not a BackupZit enrollment code (it starts with BZ1-)"; return 0 ;;
    esac
    # The rest is URL-safe base64: anything else is a damaged copy.
    case ${code#BZ1-} in
        '' | *[!A-Za-z0-9_-]*) log "ignoring $1: the enrollment code is damaged, copy it again from the console"; return 0 ;;
    esac
    printf '%s' "$code"
}

# mdm_code prints the code an MDM left for this installation. Only a file
# owned by root counts: the code decides which console controls the Mac.
mdm_code() {
    [ -f "$MDM_CODE" ] || return 0
    if [ "$(stat -f %u "$MDM_CODE")" != 0 ]; then
        log "ignoring $MDM_CODE: not owned by root"
        return 0
    fi
    read_code "$MDM_CODE"
}

# trusted_side_file succeeds when file $1, found next to package $2, can
# only have been written by root or by the owner of the package: a regular
# file, not a symbolic link, owned by one of them, in a folder owned by one
# of them that no other user can write to, or that has the sticky bit (as
# /Users/Shared), where other users cannot replace a file they do not own.
# Without this rule, anyone able to write next to the .pkg would choose the
# console that drives this root agent.
trusted_side_file() {
    if [ -L "$1" ] || [ ! -f "$1" ]; then
        log "ignoring $1: not a regular file"
        return 1
    fi
    pkg_uid=$(stat -f %u "$2" 2>/dev/null) || pkg_uid=
    file_uid=$(stat -f %u "$1" 2>/dev/null) || file_uid=
    dir=$(dirname "$1")
    dir_uid=$(stat -f %u "$dir" 2>/dev/null) || dir_uid=
    # %Lp alone leaves out the sticky bit: %Mp holds it (1777, 0755).
    dir_mode=$(stat -f %Mp%Lp "$dir" 2>/dev/null) || dir_mode=
    # Numbers only: the mode goes into shell arithmetic below.
    for v in "$pkg_uid" "$file_uid" "$dir_uid" "$dir_mode"; do
        case $v in
            '' | *[!0-9]*) log "ignoring $1: cannot read who owns it"; return 1 ;;
        esac
    done
    case $dir_mode in
        *[89]*) log "ignoring $1: cannot read the permissions of its folder"; return 1 ;;
    esac
    if [ "$file_uid" != 0 ] && [ "$file_uid" != "$pkg_uid" ]; then
        log "ignoring $1: owned neither by root nor by the owner of the package"
        return 1
    fi
    if [ "$dir_uid" != 0 ] && [ "$dir_uid" != "$pkg_uid" ]; then
        log "ignoring $1: its folder is owned neither by root nor by the owner of the package"
        return 1
    fi
    # Octal mode: 022 = writable by group or others, 01000 = sticky bit.
    if [ $((0$dir_mode & 022)) -ne 0 ] && [ $((0$dir_mode & 01000)) -eq 0 ]; then
        log "ignoring $1: other users can write to its folder"
        return 1
    fi
    return 0
}

# side_code prints the code of the backupzit-enroll.txt next to package $1,
# or nothing. A Mac already enrolled ignores it, so that an upgrade or a
# reinstall never moves the agent to another console.
side_code() {
    [ -n "$1" ] || return 0
    # Product archives may name the inner package after a '#'.
    pkg=${1%%#*}
    f="$(dirname "$pkg")/backupzit-enroll.txt"
    [ -e "$f" ] || [ -L "$f" ] || return 0
    if [ -e "$AGENT_CFG" ]; then
        log "ignoring $f: this Mac is already enrolled (to move it to another console, use $MDM_CODE)"
        return 0
    fi
    trusted_side_file "$f" "$pkg" || return 0
    read_code "$f"
}

enroll() {
    src=$MDM_CODE
    code=$(mdm_code)
    if [ -z "$code" ] && [ -n "${1:-}" ]; then
        pkg=${1%%#*}
        src="$(dirname "$pkg")/backupzit-enroll.txt"
        code=$(side_code "$1")
    fi
    [ -n "$code" ] || return 0
    log "enrolling with the code from $src"
    if "$AGENT" enroll --code "$code" --if-not-enrolled --pending-ok; then
        if [ "$src" = "$MDM_CODE" ]; then
            rm -f "$MDM_CODE"
        fi
    else
        log "enrollment failed (reason in $CFG_DIR/enroll-error.log); enroll later in Terminal: sudo $AGENT enroll --code BZ1-..."
    fi
}

# start_service installs the LaunchDaemon on the first installation (also
# before enrollment: the service waits for a code, like the MSI's); an
# upgrade keeps it (preinstall stopped it) and starts the new program.
start_service() {
    if ! "$AGENT" service status >/dev/null 2>&1; then
        if ! "$AGENT" service install; then
            log "the agent service could not be installed; run in Terminal: sudo $AGENT service install"
            return 0
        fi
    fi
    "$AGENT" service start || log "the agent service did not start (log: $LOG_FILE)"
}

# open_tray starts the menu bar app for the user at the screen now; other
# users get it at their next login from the LaunchAgent. It is started by
# launchd in the user's session ("launchctl asuser ... open" from this root
# script would run the app as root).
open_tray() {
    uid=$(stat -f %u /dev/console 2>/dev/null) || uid=
    case $uid in
        '' | 0 | *[!0-9]*) log "nobody is logged in: the menu bar app starts at the next login"; return 0 ;;
    esac
    # An upgrade may bring a changed LaunchAgent: load it again.
    launchctl bootout "gui/$uid/$TRAY_LABEL" >/dev/null 2>&1 || true
    if launchctl bootstrap "gui/$uid" "$TRAY_PLIST" 2>/dev/null; then
        return 0
    fi
    launchctl kickstart -k "gui/$uid/$TRAY_LABEL" >/dev/null 2>&1 && return 0
    # Last resort, as that user (root asks no password).
    launchctl asuser "$uid" /usr/bin/sudo -u "#$uid" /usr/bin/open -a "$APP" ||
        log "could not open the menu bar app; it starts at the next login"
}

enroll "${1:-}"
start_service
open_tray
exit 0
