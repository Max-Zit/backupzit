# backupzit hardened repository configuration. Restart after changes:
#   systemctl restart backupzit-repo

# Immutability period in days. Every stored file stays write-protected and
# undeletable for at least this long (+1 day), whatever clients do.
# Choose at least the longest retention of the backup jobs using it.
BACKUPZIT_REPO_LOCK_DAYS=30

# Storage directory (ext4, XFS or btrfs; ideally a dedicated disk).
BACKUPZIT_REPO_DATA=/srv/backupzit

# HTTPS listen address.
BACKUPZIT_REPO_LISTEN=:8500

# Extra names/IPs for the self-signed certificate generated on first start.
#BACKUPZIT_REPO_TLS_HOSTS=vault.example.com,10.0.0.30

BACKUPZIT_REPO_CONFIG=/etc/backupzit-repo
