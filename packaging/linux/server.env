# backupzit server configuration. Restart after changes:
#   systemctl restart backupzit-server

# PostgreSQL connection (required).
BACKUPZIT_DB=postgres://backupzit:CHANGE_ME@localhost:5432/backupzit?sslmode=disable

# HTTPS listen address.
BACKUPZIT_LISTEN=:8443

# URL agents use to reach this server (shown in enrollment instructions).
#BACKUPZIT_PUBLIC_URL=https://backup.example.com:8443

# Extra names/IPs for the self-signed certificate generated on first start.
#BACKUPZIT_TLS_HOSTS=backup.example.com,10.0.0.10

# Initial admin password (only used when no user exists yet). If unset, a
# random password is written to /var/lib/backupzit/initial-admin-password.txt
#BACKUPZIT_ADMIN_PASSWORD=

BACKUPZIT_DATA_DIR=/var/lib/backupzit
