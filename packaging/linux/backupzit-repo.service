[Unit]
Description=BackupZit Hardened Repository
Documentation=https://github.com/Max-Zit/backupzit
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/backupzit-repo/repo.env
ExecStart=/usr/bin/backupzit-repo serve
Restart=always
RestartSec=10
User=backupzit-repo
Group=backupzit-repo
# The only privilege: setting/clearing the immutable attribute ("chattr +i").
AmbientCapabilities=CAP_LINUX_IMMUTABLE
CapabilityBoundingSet=CAP_LINUX_IMMUTABLE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/srv/backupzit /etc/backupzit-repo
UMask=0077

[Install]
WantedBy=multi-user.target
