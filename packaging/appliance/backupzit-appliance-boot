#!/bin/sh
# Runs at every start of the BackupZit appliance (as root):
#  - grows the root file system when the VM disk was enlarged,
#  - writes the login screen text (/etc/issue).
# "backupzit-appliance-boot issue" only rewrites the screen text;
# "backupzit-appliance-boot dns" writes the DNS servers (see sync_dns);
# "backupzit-appliance-boot bzadmin" replaces bzadmin's documented initial
# password (see bzadmin_password).

log() { echo "backupzit-appliance-boot: $*"; }

# grow_root extends the partition holding the root file system (and the
# extended partition around it, on MBR disks), the LVM volume group and
# the root logical volume to the end of the disk.
grow_root() {
    src=$(findmnt -no SOURCE /) || return 0
    case "$src" in
    /dev/mapper/* | /dev/dm-*)
        lv=$src
        vg=$(lvs --noheadings -o vg_name "$lv" 2>/dev/null | tr -d ' ')
        pv=$(pvs --noheadings -o pv_name -S vg_name="$vg" 2>/dev/null | tr -d ' ' | head -1)
        ;;
    *)
        lv=""
        pv=$src
        ;;
    esac
    [ -b "$pv" ] || return 0
    part=$(basename "$(readlink -f "$pv")")
    [ -f "/sys/class/block/$part/partition" ] || return 0
    num=$(cat "/sys/class/block/$part/partition")
    disk=/dev/$(basename "$(readlink -f "/sys/class/block/$part/..")")
    total=$(blockdev --getsz "$disk")
    end=$(($(cat "/sys/class/block/$part/start") + $(cat "/sys/class/block/$part/size")))
    # Less than 100 MiB behind the partition: nothing to do.
    [ $((total - end)) -gt 204800 ] || return 0
    log "the disk $disk has $(((total - end) / 2048)) MiB unused space; growing $pv"
    if sfdisk -d "$disk" | grep -q '^label: gpt'; then
        sfdisk -q --relocate gpt-bak-std "$disk" || return 1
    fi
    if [ "$num" -ge 5 ]; then
        ext=$(sfdisk -d "$disk" | awk '/type=(f|5|85)([, ]|$)/ { sub(/ .*/, "", $1); print $1; exit }')
        if [ -n "$ext" ]; then
            echo ', +' | sfdisk -q --no-reread --no-tell-kernel -N "${ext##*[!0-9]}" "$disk" || return 1
        fi
    fi
    echo ', +' | sfdisk -q --no-reread --no-tell-kernel -N "$num" "$disk" || return 1
    partx -u "$disk" || return 1
    if [ -n "$lv" ]; then
        pvresize -q "$pv" || return 1
        lvextend -q -r -l +100%FREE "$lv" || return 1
    else
        resize2fs "$pv" >/dev/null 2>&1 || xfs_growfs / >/dev/null 2>&1 || return 1
    fi
    log "root file system now $(df -h / | awk 'NR == 2 { print $2 }')"
}

# bzadmin_password replaces the documented initial password "backupzit" of
# the setup account (installs and images up to 0.55) with a random one while
# nobody has changed it: anyone on the network could otherwise sign in over
# SSH, set a password at the forced change and use sudo (H-N3). The new one
# is shown on this screen only (the hypervisor console) until bzadmin
# changes it, which is still required at the first sign-in.
bzadmin_password() {
    bzfile=/var/lib/backupzit/initial-bzadmin-password.txt
    entry=$(getent shadow bzadmin) || return 0
    hash=$(echo "$entry" | cut -d: -f2)
    lastchg=$(echo "$entry" | cut -d: -f3)
    if [ "$lastchg" != 0 ]; then
        rm -f "$bzfile" # the administrator set a password
        return 0
    fi
    [ -f "$bzfile" ] && return 0
    # Only the documented default is replaced.
    [ "$(perl -e 'print crypt($ARGV[0], $ARGV[1])' backupzit "$hash")" = "$hash" ] || return 0
    pw=$(head -c 256 /dev/urandom | tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' | head -c 12)
    [ ${#pw} -eq 12 ] || return 1
    mkdir -p /var/lib/backupzit
    (umask 077 && echo "$pw" > "$bzfile.new") && mv "$bzfile.new" "$bzfile" || return 1
    echo "bzadmin:$pw" | chpasswd || { rm -f "$bzfile"; return 1; }
    chage -d 0 bzadmin
    log "bzadmin got a random initial password (shown on the login screen)"
}

# env_value prints setting $2 of the environment file $1 as systemd reads it
# for the console: the last "NAME=value" line counts, and quotes around the
# value go. Nothing when the file or the line is missing.
env_value() {
    [ -r "$1" ] || return 0
    sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | tail -n 1 | tr -d '\r' |
        sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

# console_url prints the web console's address for the login screen, from
# the console's configuration $1 (server.env): BACKUPZIT_PUBLIC_URL when it
# is set, else this appliance's IPv4 address (\4, filled in by the login
# prompt) with the port of BACKUPZIT_LISTEN; the console's default is :8443,
# also when the setting cannot be read.
console_url() {
    # Backslashes would be escapes for the login prompt.
    url=$(env_value "$1" BACKUPZIT_PUBLIC_URL | tr -cd '[:graph:]' | tr -d '\\')
    if [ -n "$url" ]; then
        printf '%s\n' "$url"
        return 0
    fi
    port=$(env_value "$1" BACKUPZIT_LISTEN)
    case "$port" in
    *:*) port=$(printf '%s\n' "${port##*:}" | sed 's/^0*//') ;;
    *) port= ;; # the console needs host:port, ":3000" at least
    esac
    case "$port" in
    "" | *[!0-9]* | ??????*) port=8443 ;;
    esac
    [ "$port" -le 65535 ] || port=8443
    if [ "$port" = 443 ]; then
        printf '%s\n' 'https://\4'
    else
        printf '%s\n' "https://\\4:$port"
    fi
}

# write_issue shows the console address and how to sign in. The initial
# password is shown only while the administrator has not changed it.
write_issue() {
    bzadmin_password || log "could not set a random initial password for bzadmin"
    bzfile=/var/lib/backupzit/initial-bzadmin-password.txt
    if [ -f "$bzfile" ]; then
        setup="sign in here as bzadmin (initial password: $(cat "$bzfile"),
                 must be changed)"
    else
        setup="sign in here as bzadmin"
    fi
    pwfile=/var/lib/backupzit/initial-admin-password.txt
    # The console removes the file at its start once the password was
    # changed; give a just started console a moment.
    if [ -f "$pwfile" ] && systemctl is-active -q backupzit-server 2>/dev/null; then
        sleep 3
    fi
    if [ -f "$pwfile" ]; then
        signin="admin   (initial password: $(cat "$pwfile"))
  Change it after the first sign-in."
    else
        signin="admin   (password set by the administrator;
                 setup menu item 4 sets a new one)"
    fi
    url=$(console_url /etc/backupzit/server.env)
    cat > /etc/issue <<ISSUE
BackupZit backup appliance - \n

  Web console:   $url
  Sign in as:    $signin

  Setup menu:    $setup - network, server name,
                 time zone, admin password

ISSUE
}

# sync_dns keeps /etc/resolv.conf pointing at the DNS servers of the
# network the appliance is in. systemd-networkd gets them by DHCP but only
# hands them to systemd-resolved, which the appliance does not use; without
# this, the servers of the network where the image was built would stay.
# DNS servers set in the network settings come first. Runs at every start
# and whenever networkd renews a lease (backupzit-dns.path).
sync_dns() {
    if [ -L /etc/resolv.conf ] && readlink /etc/resolv.conf | grep -q systemd; then
        return 0 # systemd-resolved does it
    fi
    files=$(ls /etc/systemd/network/*.network 2>/dev/null) || return 0
    [ -n "$files" ] || return 0
    servers=$(sed -n 's/^DNS=//p' $files | tr ' ' '\n')
    if [ -z "$servers" ]; then
        grep -qs '^DHCP=\(yes\|ipv4\|true\)' $files || return 0
        servers=$(cat /run/systemd/netif/leases/* 2>/dev/null | sed -n 's/^DNS=//p' | tr ' ' '\n')
    fi
    servers=$(printf '%s\n' "$servers" | awk 'NF && !seen[$0]++' | head -3)
    [ -n "$servers" ] || return 0
    new=$(echo "# Written by BackupZit: DNS servers of the network settings or the DHCP lease."
        for s in $servers; do echo "nameserver $s"; done)
    [ "$new" = "$(cat /etc/resolv.conf 2>/dev/null)" ] && return 0
    printf '%s\n' "$new" > /etc/resolv.conf.bz && mv /etc/resolv.conf.bz /etc/resolv.conf
    log "DNS servers: $(echo $servers)"
}

case "$1" in
issue) write_issue ;;
bzadmin) bzadmin_password ;;
dns) sync_dns ;;
*)
    grow_root || log "growing the root file system failed"
    sync_dns
    write_issue
    ;;
esac
exit 0
