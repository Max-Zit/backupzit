#!/bin/sh
# First start of the BackupZit appliance: database, configuration, console.
set -e
# A random initial password for bzadmin before SSH can answer (the image
# was built with the documented one).
/usr/local/sbin/backupzit-appliance-boot bzadmin || true
# VM images ship without SSH host keys: every copy gets its own.
if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
    ssh-keygen -A
    # SSH started before the keys existed and failed; let it start again.
    systemctl reset-failed ssh.service 2>/dev/null || true
    systemctl restart ssh 2>/dev/null || true
fi
# Wait for the network, so the certificate covers the server's address.
for i in $(seq 120); do
    IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") print $(i + 1)}')
    [ -n "$IP" ] && break
    sleep 1
done
DB_PASS=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)
systemctl start postgresql
# The password stays out of the process list: the SQL goes to psql on
# stdin (printf is a shell builtin) and the URL reaches awk through its
# environment. ON_ERROR_STOP makes psql fail on an existing user, as -c did.
pg_sql() { printf '%s\n' "$1" | su postgres -c "psql -X -q -v ON_ERROR_STOP=1"; }
pg_sql "CREATE USER backupzit PASSWORD '$DB_PASS';" 2>/dev/null ||
    pg_sql "ALTER USER backupzit PASSWORD '$DB_PASS';"
su postgres -c "createdb -O backupzit backupzit" 2>/dev/null || true
ENV=/etc/backupzit/server.env
tmp=$(mktemp)
DB_URL="postgres://backupzit:$DB_PASS@localhost:5432/backupzit?sslmode=disable" \
    awk '/^BACKUPZIT_DB=/ { print "BACKUPZIT_DB=" ENVIRON["DB_URL"]; next } { print }' $ENV > "$tmp"
cat "$tmp" > $ENV
rm -f "$tmp"
# The certificate names the server; agents pin it, browsers show a warning
# until a trusted certificate is set up under Settings → Certificate.
grep -q '^BACKUPZIT_TLS_HOSTS=' $ENV || echo "BACKUPZIT_TLS_HOSTS=${IP:+$IP,}$(hostname -f)" >> $ENV
systemctl enable --now backupzit-server
for i in $(seq 60); do [ -f /var/lib/backupzit/initial-admin-password.txt ] && break; sleep 1; done
# The login screen (address, how to sign in) is written again at every
# start by backupzit-appliance-boot (from the server package).
/usr/local/sbin/backupzit-appliance-boot issue || true
touch /var/lib/backupzit/.appliance-ready
